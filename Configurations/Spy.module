#!url=https://raw.githubusercontent.com/Krest-Neva/Shadowrocket/main/Configurations/Spy.module
#!name=Spy
#!desc=Универсальный отладчик HTTP-запросов и ответов

#===================================================
# ОПИСАНИЕ АРГУМЕНТОВ (передаются в JSON в параметре argument)
#===================================================

# color (true/false)          – префиксы метода и статуса (по умолчанию true)
# time (true/false)           – метка времени ISO (true)
# size (true/false)           – размер тела (B/KB/MB) (true)
# contentType (true/false)    – показывать Content-Type (true)
# headers (true/false)        – показывать заголовки (true)
# compactBody (true/false)    – компактный вывод тела: структура JSON, ключи и превью (true)
# maxLength (число)           – макс. длина тела при полном выводе (если compactBody=false), 0 = без ограничений
# highlight (массив строк)    – подсветка слов >>>слово<<< и поиск в ключах JSON ([] – пусто)
# counter (true/false)        – глобальный счётчик запросов (#1, #2…) (false)
# ignoreTypes (массив строк)  – игнорировать ответы с Content-Type, начинающимся с префиксов ([] – пусто)
# ignoreRequestTypes (bool)   – применять ignoreTypes и к исходящим запросам (false)
# showBody (true/false)       – показывать тело запроса/ответа (true)
# maxPrintLength (число)      – макс. длина текстового тела при compactBody=true (2000)
# showUrlParts (true/false)   – показывать разобранный URL (схема, хост, путь, query, hash) (true)
# collapseWhitespace (true/false) – сжимать пробелы и переводы строк в текстовых телах (true)
# binaryPreview (true/false)  – показывать превью бинарных тел (true)
# binaryPreviewLength (число) – длина превью бинарного тела (240)
# hexPreviewLength (число)    – длина hex-дампа (если showHex=true) (96)
# maxDepth (число)            – макс. глубина обхода JSON для структуры (4)
# maxObjectKeys (число)       – макс. количество выводимых ключей JSON (60)
# maxSnippets (число)         – макс. количество сниппетов вокруг highlight-слов (5)
# snippetRadius (число)       – радиус (символов) вокруг найденного слова в сниппете (48)
# showHex (true/false)        – показывать hex-дамп бинарных тел (false)
# showAscii (true/false)      – показывать ASCII-превью бинарных тел (true)
# showEmptyBinary (true/false) – показывать превью даже без highlight-совпадений (true)
# repairMojibake (true/false) – автоматически исправлять ошибочно декодированный UTF-8 (Ð±Ñ...) (true)

#===================================================
# Пример: {"compactBody":true,"highlight":["token","secret"],"counter":true}
#===================================================

[RULE]
AND,((PROTOCOL,UDP), (DST-PORT,443)),REJECT-NO-DROP

[Script]
# Заменить example.com
Spy-Request = type=http-request,pattern=^https?:\/\/(?:[a-zA-Z0-9-]+\.)*example\.com\/.*$,requires-body=0,script-path=https://raw.githubusercontent.com/Krest-Neva/Shadowrocket/refs/heads/main/Scripts/Spy.js,argument={"color":true,"time":true,"size":true,"contentType":true,"headers":true,"compactBody":true,"maxLength":0,"highlight":["premium","token","videoId","watchEndpoint","browseId","clientName","clientVersion"],"counter":true,"ignoreTypes":["image/","font/","text/css","text/javascript"],"ignoreRequestTypes":false,"maxPrintLength":2000,"showBody":true,"showUrlParts":true,"collapseWhitespace":true,"binaryPreview":true,"binaryPreviewLength":240,"hexPreviewLength":96,"maxDepth":4,"maxObjectKeys":60,"maxSnippets":5,"snippetRadius":48,"showHex":false,"showAscii":true,"showEmptyBinary":true,"repairMojibake":true}
Spy-Response = type=http-response,pattern=^https?:\/\/(?:[a-zA-Z0-9-]+\.)*example\.com\/.*$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Krest-Neva/Shadowrocket/refs/heads/main/Scripts/Spy.js,argument={"color":true,"time":true,"size":true,"contentType":true,"headers":true,"compactBody":true,"maxLength":0,"highlight":["premium","token","videoId","watchEndpoint","browseId","clientName","clientVersion"],"counter":true,"ignoreTypes":["image/","font/","text/css","text/javascript"],"ignoreRequestTypes":false,"maxPrintLength":2000,"showBody":true,"showUrlParts":true,"collapseWhitespace":true,"binaryPreview":true,"binaryPreviewLength":240,"hexPreviewLength":96,"maxDepth":4,"maxObjectKeys":60,"maxSnippets":5,"snippetRadius":48,"showHex":false,"showAscii":true,"showEmptyBinary":true,"repairMojibake":true}

[MITM]
enable = true
h2 = false
# Добавить сюда домены, указанные в pattern выше.
# Использовать %APPEND% для добавления к существующему списку.
hostname = %APPEND%
