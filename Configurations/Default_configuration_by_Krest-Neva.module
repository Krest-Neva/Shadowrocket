#Глобальный прокси🌍
FINAL,BESTPROXY

[Host]
localhost = 127.0.0.1

[Header Rewrite]
#Spotify🎶
^https?:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com)(:443)?\/user-customization-service\/v1\/customize header-del if-none-match

[URL Rewrite]
#YOUTUBE🔴
^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback\?)).+&oad _ reject-200
^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads _ reject-200
^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking) _ reject-200
^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext _ reject-200
(^https?:\/\/[\w-]+\.googlevideo\.com\/(?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+) $1$2$3 302

#YANDEX каки✴️
#UTM
^(https?:\/\/[^?]+)\?(.+)&utm_[^&]+(.*)$ $1?$2$3 302
^(https?:\/\/[^?]+)\?utm_[^&]+&(.+)$ $1?$2 302
^(https?:\/\/[^?]+)\?utm_[^&]+$ $1 302
#Yandex (yclid)
^(https?:\/\/[^?]+)\?(.+)&yclid=[^&]+(.*)$ $1?$2$3 302
^(https?:\/\/[^?]+)\?yclid=[^&]+&(.+)$ $1?$2 302
^(https?:\/\/[^?]+)\?yclid=[^&]+$ $1 302
#Facebook (fbclid)
^(https?:\/\/[^?]+)\?(.+)&fbclid=[^&]+(.*)$ $1?$2$3 302
^(https?:\/\/[^?]+)\?fbclid=[^&]+&(.+)$ $1?$2 302
^(https?:\/\/[^?]+)\?fbclid=[^&]+$ $1 302
#Google Ads (gclid)
^(https?:\/\/[^?]+)\?(.+)&gclid=[^&]+(.*)$ $1?$2$3 302
^(https?:\/\/[^?]+)\?gclid=[^&]+&(.+)$ $1?$2 302
^(https?:\/\/[^?]+)\?gclid=[^&]+$ $1 302
#Регионы
^http://(www\.)?yandex\.ru https://yandex.com 302
^https://(www\.)?yandex\.ru https://yandex.com 302
^http://(www\.)?yandex\.kz(.*)$ http://yandex.com$2 302
^http://(www\.)?yandex\.az(.*)$ http://yandex.com$2 302
