#!desc=Pro-grade networking for iOS/macOS

#Последние изменения 24.04.2026 22:00
#Фильтры обновлены 22.04.2026 05:00

#==================================================
# ℹ️ ИНФОРМАЦИЯ О КОНФИГУРАЦИИ

# Данный конфиг предназначен исключительно для систем iOS и macOS.
# Для доступа с других платформ используйте функцию «Общий доступ к прокси».

# Конфигурация создана Кристиной Невской специально для «настоящих котиков».
# Включает регулярные обновления маршрутизации и скрипты для получения премиум-функций,
# а также блокировку рекламы, трекеров, систем аналитики и фишинговых сайтов.

# ПРИНЦИП РАБОТЫ:
# Локальные сервера, RU-сервисы и ресурсы, которые нельзя пускать через прокси,
# работают напрямую (без VPN) для обеспечения максимальной скорости.
# Конфиг адаптирован для постоянного использования без необходимости отключать VPN.
# Автоматическое переключение обеспечивается индивидуально настроенными группами прокси.

# Конфигурация работает как модуль в Shadowrocket. Настройки модуля имеют приоритет
# над основной конфигурацией. Персональный Add-on должен находиться выше данного модуля.

# ➕ ДОБАВЛЕНИЕ ПОДПИСКИ:
# 1. На главной странице нажмите «+».
# 2. Выберите тип «Subscribe».
# 3. Вставьте ваш URL (ключ).
# 4. В поле «Примечания» укажите название вашего VPN-сервиса.

# 📂 НАСТРОЙКИ ОСНОВНОЙ КОНФИГУРАЦИИ:
# Основной файл конфигурации должен быть пустым (за исключением настроек ниже).
# 1. Перейдите в раздел локальных файлов (кнопка справа на главной).
# 2. Найдите default.conf, переименуйте его (название может быть любым).
# 3. Нажмите на файл и выберите «Редактировать текст».
# 4. Полностью удалите всё содержимое.
# 5. Если файла нет, выберите «Восстановить конфигурацию по умолчанию» и повторите действия.

# 🔐 НАСТРОЙКА HTTPS И СЕРТИФИКАТОВ:
# Дальнейшая настройка выполняется через интерфейс редактирования (кнопка «i»).
# Необходимо установить и сделать доверенным корневой сертификат Shadowrocket:
# 1. Включите «Расшифровка HTTPS». Приложение предложит установить сертификат — подтвердите.
# 2. В настройках iPhone (в самом верху) появится профиль сертификата — установите его.
# 3. Перейдите в «Настройки» -> «Основные» -> «Об этом устройстве» -> «Доверие сертификатам» (внизу).
# 4. Включите доверие для сертификата Shadowrocket.
# 5. В разделе «VPN и управление устройством» убедитесь, что профиль установлен и доверен.
# 6. Вернитесь в Shadowrocket и проверьте статус в разделе расшифровки HTTPS.

# ЗАЧЕМ ЭТО НУЖНО: 
# Расшифровка HTTPS необходима для глубокой фильтрации трафика и работы скриптов.
# Это позволяет, например, использовать YouTube в режиме «Картинка в картинке» 
# и слушать видео с выключенным экраном без рекламы.

# 🌐 НАСТРОЙКА ГРУПП ПРОКСИ:
# Группы позволяют автоматически выбирать рабочие сервера. При сбое соединения 
# система сама переключится на доступный узел на основе теста через специальный URL.

# СПИСОК ГРУПП:
# 1️⃣ «BESTPROXY» (load-balance) — Тест: https://cp.cloudflare.com/generate_204
# 2️⃣ «COPILOTPROXY» (load-balance) — Тест: https://login.microsoftonline.com/favicon.ico
# 3️⃣ «DISCORDPROXY» (fallback) — Тест: https://discord.com/api/v9/gateway
# 4️⃣ «GEMINIPROXY» (load-balance) — Тест: https://www.google.com/generate_204
# 5️⃣ «GPTPROXY» (load-balance) — Тест: https://chat.openai.com/favicon.ico
# 6️⃣ «INSTPROXY» (load-balance) — Тест: https://fbcdn.net
# 7️⃣ «SELECTPROXY» (select) — Тест: https://www.gstatic.com/generate_204
# 8️⃣ «SPEEDPROXY» (url-test) — Тест: https://www.youtube.com/generate_204
# 9️⃣ «SPOTIFYPROXY» (fallback) — Тест: https://open.spotify.com
# 🔟 «TGPROXY» (load-balance) — Тест: https://www.telegram.org
# 1️⃣1️⃣ «TIKTOKPROXY» (url-test) — Тест: https://www.tiktok.com/favicon.ico

# ОПИСАНИЕ СТРАТЕГИЙ:
# — load-balance: Распределяет трафик между несколькими быстрыми серверами одновременно (наиболее быстро).
# — url-test: Выбирает один самый быстрый сервер по минимальной задержке (наиболее быстро, но для сервисов чувствительных к быстрой смене ip-адреса).
# — fallback: Выбирает первый доступный сервер в списке (наиболее стабильно).
# - select: Простой выбор сервера по умолчанию вручную

# РЕКОМЕНДУЕМЫЕ ТАЙМ-АУТЫ:
# — Тайм-аут: около 2 сек.
# — Интервал проверки: 200 сек (при стабильной работе) или 60 сек (при частых сбоях).

# 🧩 МОДУЛИ:
# В разделе локальных файлов (справа на главной) есть пункт «Модули». 
# Через «+» вставляется ссылка на модули. Они имеют приоритет над основным конфигом.

# ⚙️ НАСТРОЙКИ ПРИЛОЖЕНИЯ:

# 🏠 ВКЛАДКА «ГЛАВНАЯ»:
# — Маршрутизация: выберите «Настройка» (для работы правил и модулей).
# — Откат: рекомендуется отключить.
# — Тест подключения: тип «connect». URL: http://cp.cloudflare.com/generate_204
# (Важно: если сервер не пингует Google, это не значит, что он не работает с другими сервисами).

# ⚙️ ВКЛАДКА «НАСТРОЙКИ»:
# — По требованию: «Всегда включено» — Вкл, «По требованию» — Вкл.
# — Правила по требованию (внизу): Действие — «Подключить», Сеть — «Any». 
# — (Опционально): В настройках iOS (раздел VPN) включите «Подключение по запросу» для SR.
# — Туннель: Активируйте «Только принудительные маршруты».
# — UDP: Включите «Реле».
# — Подписки: Включите автообновление и опцию «Отправить HWID».
# — База данных Geolite2: Включите автообновление с минимальным интервалом.
#   URL Country: https://github.com/Loyalsoldier/geoip/raw/release/Country.mmdb
#   URL ASN: https://github.com/Loyalsoldier/geoip/raw/release/GeoLite2-ASN.mmdb
# — Разное: Включите «Модерируемый механизм политики» и «Исключение маршрутов 0.0.0.0/31».

# 📈 РАЗДЕЛ «ДАННЫЕ»:
# — Включите «Автосинхронизация iCloud».
# — Включите логирование прокси и DNS.
# — Активируйте «Перезаписать существующий» и «Автоматическое переименование».

# 👍 РЕЖИМЫ ИСПОЛЬЗОВАНИЯ (НА ГЛАВНОЙ):
# 1. Настройка — использование правил конфигурации и модулей (рекомендуется).
# 2. Прокси — весь трафик идет через VPN.
# 3. Напрямую — весь трафик идет в обход VPN.

# Обратную связь, жалобы (с прикрепленными логами) и пожелания 
# направляйте моему менеджеру😡
#==================================================

#   #-неакт❌

[General]
# === Основные ===
# Использовать IPv6
ipv6 = true
# Автоматическое создание виртуального интерфейса для IPv6
ipv6-vif = auto
# Предпочтение IPv6 перед IPv4
prefer-ipv6 = false
# Таймаут тестирования соединения (сек)
test-timeout = 5
# URL для проверки доступа в интернет
internet-test-url = https://www.google.com
# URL для проверки работы прокси
proxy-test-url = https://www.gstatic.com/generate_204
# Показывать страницу ошибки при блокировке
show-error-page-for-reject = true
# Уровень логирования
loglevel = error
# === DNS ===
# Перехват DNS-запросов на указанный порт
hijack-dns = *:53
# DNS через HTTPS
dns-over-https = true
# Использовать системный DNS для DIRECT-соединений
dns-direct-system = true
# Использовать системный DNS как резервный
dns-fallback-system = false
# Проксировать DNS, если прямое соединение не работает
dns-direct-fallback-proxy = true
# Основные DNS-серверы
dns-server = https://dns.comss.one/dns-query#proxy,https://dns.comss.one/dns-query,https://94.140.14.14/dns-query#proxy,https://doh.dns.sb/dns-query#proxy,https://9.9.9.9/dns-query#direct
# Резервные DNS-серверы
fallback-dns-server = https://1.1.1.1/dns-query#proxy,https://1.0.0.1/dns-query#proxy,https://8.8.8.8/dns-query#direct,https://8.8.4.4/dns-query#direct,https://dns.alidns.com/dns-query,https://doh.libredns.gr/dns-query
# Пропускать проверку сертификата для DNS-over-HTTPS
doh-skip-cert-verification = true
# Отвечать на DNS-запросы к частным IP
private-ip-answer = true
# Читать локальный файл hosts
read-etc-hosts = false
# Использовать современный тип DNS-записей SVCB для ускорения
allow-dns-svcb = true
# DNS-сервер для резолвинга адресов прокси (основной DoH)
proxy-dns-server = https://dns.comss.one/dns-query
# Всегда использовать локальный DNS для всех доменов (отключено)
always-ip-address = false
# === Исключения из прокси / маршрутизация ===
# Адреса, исключённые из проксирования
skip-proxy = apple.com,icloud.com,*.cdn-apple.com,*.mzstatic.com,itunes.apple.com,captive.apple.com,gsp1.apple.com,*.local,localhost,apple-pki.com,digicert.com,entrust.net,*.gosuslugi.ru,*.nalog.gov.ru,*.nalog.ru,*.mos.ru,*.fssprus.ru,*.pfr.gov.ru,*.sberbank.ru,*.sber.ru,*.tbank.ru,*.tinkoff.ru,*.alfabank.ru,*.vtb.ru,*.gazprombank.ru,*.raiffeisen.ru,*.rshb.ru,*.pochtabank.ru,*.open.ru,*.magnit.ru,*.mgnt.ru,*.moy-magnit.ru,*.magnit.one,*.tander.ru,*.wildberries.ru,*.wb.ru,*.ozon.ru,*.lenta.com,*.samokat.ru,*.kuper.ru,*.sbermarket.ru,*.delivery-club.ru,*.market-delivery.ru,*.vkusvill.ru,*.perekrestok.ru,*.5ka.ru,*.lamoda.ru,*.avito.ru,*.mvideo.ru,*.eldorado.ru,*.dns-shop.ru,*.mts.ru,*.megafon.ru,*.beeline.ru,*.tele2.ru,*.rt.ru,*.2gis.ru,*.rzd.ru,*.aeroflot.ru,*.s7.ru
# Домены, для которых всегда используется реальный IP
always-real-ip = *.apple.com,*.icloud.com,*.itunes.com,*.mzstatic.com,*.apple-pki.com,*.push.apple.com,*.gosuslugi.ru,*.nalog.gov.ru,*.nalog.ru,*.mos.ru,*.fssprus.ru,*.pfr.gov.ru,*.sberbank.ru,*.sber.ru,*.tbank.ru,*.tinkoff.ru,*.alfabank.ru,*.vtb.ru,*.gazprombank.ru,*.raiffeisen.ru,*.rshb.ru,*.pochtabank.ru,*.open.ru,*.magnit.ru,*.mgnt.ru,*.moy-magnit.ru,*.magnit.one,*.tander.ru,*.wildberries.ru,*.wb.ru,*.ozon.ru,*.lenta.com,*.samokat.ru,*.kuper.ru,*.sbermarket.ru,*.delivery-club.ru,*.market-delivery.ru,*.vkusvill.ru,*.perekrestok.ru,*.5ka.ru,*.lamoda.ru,*.avito.ru,*.mvideo.ru,*.eldorado.ru,*.dns-shop.ru,*.mts.ru,*.megafon.ru,*.beeline.ru,*.tele2.ru,*.rt.ru,*.2gis.ru,*.rzd.ru,*.aeroflot.ru,*.s7.ru,*.yandex.ru,*.ya.ru,*.yandex.net,*.vk.com,*.vk.me,*.ok.ru,*.mail.ru,*.dzen.ru,*.rutube.ru,*.kaspersky.ru
# Исключённые из туннеля IP-маршруты
tun-excluded-routes = 10.0.0.0/8,17.0.0.0/8,100.64.0.0/10,127.0.0.0/8,169.254.0.0/16,172.16.0.0/12,192.0.0.0/24,192.0.2.0/24,192.88.99.0/24,192.168.0.0/16,198.51.100.0/24,203.0.113.0/24,224.0.0.0/4,255.255.255.255/32,fc00::/7,fe80::/10,178.248.232.0/21,82.148.11.0/24,185.15.56.0/22,91.223.116.0/22
# Всегда использовать RAW TCP для указанных хостов
always-raw-tcp-hosts = www.google.com,91.108.56.*,91.108.4.*,91.108.8.*,91.108.16.*,91.108.12.*,149.154.16*,149.154.17*,91.108.20.*,185.76.151.*,91.105.192.*,5.28.19*
# Приоритет UDP-трафика
udp-priority = true
# Гибридный режим для всех соединений
all-hybrid = true
# Действие при отсутствии поддержки UDP
udp-policy-not-supported-behaviour = REJECT
# Автоматический ответ на ICMP-запросы
icmp-auto-reply = false
# Игнорировать системные настройки прокси
bypass-system = true
# Исключать простые имена хостов из прокси
exclude-simple-hostnames = true
# Использовать политику по умолчанию, если Wi-Fi не основной
use-default-policy-if-wifi-not-primary = false
# Ассистент Wi-Fi
wifi-assist = false
# Разрешить доступ к прокси через Wi-Fi
allow-wifi-access = true
# Разрешить доступ через режим модема
allow-hotspot-access = true
# Порт для HTTP-доступа к прокси в локальной сети
wifi-access-http-port = 1082
# Скрыть значок VPN в статус-баре
hide-vpn-icon = true
# === Управление ===
# HTTP API для управления (логин:пароль@адрес:порт)
#http-api = 
# Включить веб-панель управления
http-api-web-dashboard = false
# === Дополнительно ===
# Ссылка на базу GeoIP (страны)
geoip-maxmind-url = https://github.com/Loyalsoldier/geoip/raw/release/Country.mmdb
# Не использовать localhost для прокси-серверов
use-local-host-item-for-proxy = false
# Всегда отклонять перезапись URL
always-reject-url-rewrite = false
# === Безопасность и защита от утечек ===
# Блокировать QUIC для принудительного использования HTTPS/TCP
block-quic = true
# Подставной IPv4 для предотвращения утечки WebRTC
stun-response-ip = 0.0.0.0
# Подставной IPv6 для предотвращения утечки WebRTC
stun-response-ipv6 = ::1
# === Ситуационные параметры ===
# Режим совместимости 5: альтернативный обход ограничений оператора
#compatibility-mode = 5
# Режим совместимости 3: принудительный TUN
#compatibility-mode = 3
# Режим совместимости 4: только прокси-режим
#compatibility-mode = 4
# Агрессивная блокировка QUIC (все порты)
#block-quic = all

[Replica]
# Скрывать запросы репортера сбоев
hide-crash-reporter-request = false
# Включить фильтр по ключевым словам
keyword-filter-type = true

[Rule]
#Локальные сети
GEOIP,private,DIRECT

#Переключение YouTube с UDP/QUIC на TCP/HTTPS
AND,((DOMAIN-SUFFIX,googlevideo.com), (PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com), (PROTOCOL,UDP)),REJECT

#Реклама в Spotify🎶
#AND,((DOMAIN-SUFFIX,spotify.com), (PROTOCOL,UDP)),REJECT
URL-REGEX,^https?:\/\/(.*-ad-logic.*|crashdump\.spotify\.com|log\.spotify\.com|spclient\.wg\.spotify\.com\/(ad-logic|ads))\/,REJECT

#Реклама, трекеры, аналитика, фишинг и остальная кака💩
#RULE-SET,https://raw.githubusercontent.com/Krest-Neva/Shadowrocket/refs/heads/main/REJECT_RULES/REJECT_RULES_STD.list,REJECT-DICT
#RULE-SET,https://raw.githubusercontent.com/Krest-Neva/Shadowrocket/refs/heads/main/REJECT_RULES/REJECT_RULES_PLUS.list,REJECT-DICT
#RULE-SET,https://raw.githubusercontent.com/Krest-Neva/Shadowrocket/refs/heads/main/REJECT_RULES/REJECT_RULES_STD_SMALL.list,REJECT-DICT
