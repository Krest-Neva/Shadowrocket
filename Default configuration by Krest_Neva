#👍Настройка при использовании
#На главной есть три типа маршрутизации. Настройка - с использованием правил конфигураций и модулей. Прокси - проксируется весь трафик. Напрямую - весь трафик идёт в обход VPN


#Жалобы (логи экспортируемым файлом) и пожелания направлять моему менеджеру😡
#==================================================

#   #-неакт❌

[General]
#Поддержка ipv6
ipv6 = true
#Приоритет ipv6
prefer-ipv6 = false
#Не проксировать
skip-proxy = apple.com,icloud.com,*.cdn-apple.com,*.mzstatic.com,itunes.apple.com,captive.apple.com,gsp1.apple.com,*.local,localhost,apple-pki.com,digicert.com,entrust.net
#Всегда реальный ip
always-real-ip = *.apple.com,*.icloud.com,*.itunes.com,*.mzstatic.com,*.apple-pki.com,*.push.apple.com
#Исключённые маршруты
tun-excluded-routes = 10.0.0.0/8,17.0.0.0/8,100.64.0.0/10,127.0.0.0/8,169.254.0.0/16,172.16.0.0/12,192.0.0.0/24,192.0.2.0/24,192.88.99.0/24,192.168.0.0/16,198.51.100.0/24,203.0.113.0/24,224.0.0.0/4,255.255.255.255/32,fc00::/7,fe80::/10
#Использование доменных DNS
dns-over-https = true
#Системный DNS
dns-direct-system = false
#Резервный системный DNS
dns-fallback-system = false
#Проксирование DNS если прямое соединение не работает
dns-direct-fallback-proxy = true
#DNS сервера
dns-server = https://dns.comss.one/dns-query#proxy,https://dns.comss.one/dns-query,https://94.140.14.14/dns-query#proxy,https://doh.dns.sb/dns-query#proxy,https://9.9.9.9/dns-query#direct
#Резервные DNS сервера
fallback-dns-server = https://1.1.1.1/dns-query#proxy,https://1.0.0.1/dns-query#proxy,https://8.8.8.8/dns-query#direct,https://8.8.4.4/dns-query#direct,https://dns.alidns.com/dns-query,https://doh.libredns.gr/dns-query
#Перехват DNS
hijack-dns = *:53
#DNS-запросы для частных ip-адресов
private-ip-answer = true
#Игнорирование системных настроек прокси
bypass-system = true
#Принудительное отклонение перезаписи URL
always-reject-url-rewrite = false
#Автоматический ответ на ICMP-запросы
icmp-auto-reply = false
#Действие при отсутствии поддержки UDP
udp-policy-not-supported-behaviour = REJECT
#Не использовать localhost для прокси серверов
use-local-host-item-for-proxy = false

